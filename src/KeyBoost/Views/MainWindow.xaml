<ui:FluentWindow x:Class="KeyBoost.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="KeyBoost" Width="1200" Height="760" MinWidth="920" MinHeight="640" WindowStartupLocation="CenterScreen" Icon="../Resources/KeyBoost.ico" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable, Segoe UI" ExtendsContentIntoTitleBar="True">
  <DockPanel>
    <ui:TitleBar x:Name="TitleBar" DockPanel.Dock="Top" Title="KeyBoost   /   Keyboard Control &amp; Diagnostics" ShowMaximize="True" />
    <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
    </Border>
    <Border DockPanel.Dock="Left" Width="224" Padding="16,28,16,16" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,32">
          <TextBlock Text="KEYBOOST" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="Control. Observe. Understand." Margin="0,8,0,0" FontSize="11" Opacity="0.65" />
        </StackPanel>
        <ListBox x:Name="Navigation" SelectionChanged="Navigate" SelectedIndex="0" Background="Transparent" BorderThickness="0">
          <ListBoxItem Tag="Overview" Padding="14" ToolTip="Overview">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Home24" Margin="0,0,12,0" />
              <TextBlock Text="Overview" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Keyboard Settings" Padding="14" ToolTip="Keyboard Settings">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Keyboard24" Margin="0,0,12,0" />
              <TextBlock Text="Keyboard Settings" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Input Tester" Padding="14" ToolTip="Input Tester">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Pulse24" Margin="0,0,12,0" />
              <TextBlock Text="Input Tester" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Profiles" Padding="14" ToolTip="Profiles">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Person24" Margin="0,0,12,0" />
              <TextBlock Text="Profiles" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Diagnostics" Padding="14" ToolTip="Diagnostics">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Info24" Margin="0,0,12,0" />
              <TextBlock Text="Diagnostics" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Settings" Padding="14" ToolTip="Settings">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" />
              <TextBlock Text="Settings" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Margin="32,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,24">
        <Button DockPanel.Dock="Right" Content="Toggle theme" Click="ToggleTheme" />
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Overview" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ActiveLabel}" Margin="0,8,0,0" Opacity="0.7" />
        </StackPanel>
      </DockPanel>
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="OverviewPage" Style="{StaticResource PageEntrance}" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Your keyboard, clearly understood." FontSize="21" Margin="0,0,0,16" />
            <Border Padding="24" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel>
                <TextBlock Text="WINDOWS CHARACTER REPETITION" FontSize="11" Opacity="0.6" />
                <TextBlock Text="{Binding CurrentLabel}" FontSize="24" Margin="0,14,0,16" />
                <TextBlock Text="These settings control repeated characters in Windows. They do not change physical actuation or the direct input latency of most games." />
                <WrapPanel Margin="0,18,0,0">
                  <ComboBox Width="190" Margin="0,4,10,4" ItemsSource="{Binding ElementName=ProfilePicker, Path=ItemsSource}" DisplayMemberPath="Name" SelectedItem="{Binding ElementName=ProfilePicker, Path=SelectedItem, Mode=TwoWay}" AutomationProperties.Name="Overview preset" />
                  <Button IsEnabled="{Binding ElementName=ProfilePicker, Path=HasItems}" Content="Apply selected preset" Click="ApplyProfile" />
                  <Button Content="Refresh settings" Command="{Binding ReadCommand}" />
                  <Button Content="Open diagnostics" Click="OpenDiagnostics" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="Connected keyboard interfaces" FontSize="16" Margin="0,26,0,12" />
            <TextBlock x:Name="DeviceSummary" FontFamily="Consolas" FontSize="11" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="KeyboardPage" Style="{StaticResource PageEntrance}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Windows repeat settings" FontSize="20" />
            <TextBlock Text="Changes apply to your Windows user account and other applications." Margin="0,8,0,24" Opacity="0.7" />
            <TextBlock Text="{Binding DelayLabel}" />
            <Slider Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Delay}" Margin="0,16,0,24" AutomationProperties.Name="Repeat delay" />
            <TextBlock Text="Repeat speed (Windows units, 0–31)" />
            <Slider Minimum="0" Maximum="31" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Speed}" Margin="0,16,0,8" AutomationProperties.Name="Repeat speed" />
            <TextBlock Text="{Binding Speed}" />
            <WrapPanel Margin="0,24,0,20">
              <Button Content="Read current settings" Command="{Binding ReadCommand}" />
              <Button Content="Apply settings" Command="{Binding ApplyCommand}" />
              <Button Content="Save as profile" Click="CreateProfile" />
              <Button Content="Restore previous settings" Command="{Binding RestoreCommand}" />
            </WrapPanel>
            <TextBlock Text="Delay: 250–1000 ms. Speed: Windows-defined scale, approximately 2.5–30 repeated characters per second. Applications may ignore these settings." Opacity="0.7" />
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="InputPage" Style="{StaticResource PageEntrance}" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Text="Focus the test surface, then press keys. Tab moves focus out. Events are never captured outside this surface. Windows-reserved shortcuts may not arrive." />
          <Border x:Name="TestSurface" Grid.Row="1" Focusable="True" MouseDown="FocusTester" GotKeyboardFocus="TesterFocused" LostKeyboardFocus="TesterBlurred" Padding="12" Margin="0,16,0,12" BorderBrush="#3487EF" BorderThickness="1" CornerRadius="8" AutomationProperties.Name="Keyboard testing surface">
            <StackPanel>
              <TextBlock x:Name="InputStatus" Text="Click here to begin focused testing" Margin="0,0,0,8" />
              <StackPanel x:Name="KeyboardLayout" />
              <TextBlock Text="Compact US logical layout · additional keys appear in event history" FontSize="10" Opacity="0.65" Margin="2,6,0,0" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="ConcurrentLabel" Grid.Row="2" Text="Observed concurrent keys: 0 · Peak: 0" />
          <WrapPanel Grid.Row="3" Margin="0,8">
            <TextBox AutomationProperties.Name="Expected key combination" x:Name="ExpectedKeys" Width="240" ToolTip="Expected combination, e.g. A,S,D or LeftCtrl,A" />
            <Button Content="Check expected combination" Click="CheckCombination" />
            <Button Content="Clear results" Click="ClearInput" />
          </WrapPanel>
          <ListBox x:Name="EventHistory" Grid.Row="4" FontFamily="Consolas" FontSize="12" />
        </Grid>
        <ScrollViewer x:Name="ProfilesPage" Style="{StaticResource PageEntrance}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Profiles store supported Windows repeat settings only." Margin="0,0,0,16" />
            <ComboBox AutomationProperties.Name="Selected keyboard profile" x:Name="ProfilePicker" DisplayMemberPath="Name" SelectionChanged="ProfileSelected" MinWidth="300" HorizontalAlignment="Left" />
            <TextBox x:Name="ProfileName" Margin="0,16,0,12" MaxLength="64" ToolTip="Profile name" AutomationProperties.Name="Profile name" />
            <WrapPanel>
              <Button Content="Create from sliders" Click="CreateProfile" />
              <Button IsEnabled="{Binding ElementName=ProfilePicker, Path=HasItems}" Content="Rename" Click="RenameProfile" />
              <Button IsEnabled="{Binding ElementName=ProfilePicker, Path=HasItems}" Content="Apply" Click="ApplyProfile" />
              <Button IsEnabled="{Binding ElementName=ProfilePicker, Path=HasItems}" Content="Delete" Click="DeleteProfile" />
              <Button Content="Import JSON" Click="ImportProfile" />
              <Button IsEnabled="{Binding ElementName=ProfilePicker, Path=HasItems}" Content="Export JSON" Click="ExportProfile" />
            </WrapPanel>
            <TextBlock Text="Windows Default is a conventional preset (delay 1, speed 31), not a snapshot of your original settings. Restore previous settings uses your saved pre-change snapshot." Margin="0,24,0,0" Opacity="0.7" />
          </StackPanel>
        </ScrollViewer>
        <DockPanel x:Name="DiagnosticsPage" Style="{StaticResource PageEntrance}" Visibility="Collapsed">
          <WrapPanel DockPanel.Dock="Top">
            <Button Content="Refresh diagnostics" Click="RefreshDiagnostics" />
            <Button Content="Export diagnostic report" Click="ExportDiagnostics" />
          </WrapPanel>
          <TextBox x:Name="DiagnosticText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,12,0,0" />
        </DockPanel>
        <ScrollViewer x:Name="SettingsPage" Style="{StaticResource PageEntrance}" Visibility="Collapsed">
          <StackPanel>
            <ui:ToggleSwitch x:Name="LightTheme" Content="Light theme" Click="PreferenceChanged" Margin="0,8" />
            <ui:ToggleSwitch x:Name="StartupToggle" Content="Start with Windows (current user)" Click="StartupChanged" Margin="0,8" />
            <ui:ToggleSwitch x:Name="TrayToggle" Content="Minimize to system tray" Click="PreferenceChanged" Margin="0,8" />
            <ui:ToggleSwitch x:Name="ConfirmToggle" Content="Confirm before closing" Click="PreferenceChanged" Margin="0,8" />
            <WrapPanel Margin="0,24">
              <Button Content="Restore previous keyboard settings" Command="{Binding RestoreCommand}" />
              <Button Content="Reset app preferences" Click="ResetPreferences" />
            </WrapPanel>
            <TextBlock Text="KeyBoost 1.0.0" FontSize="20" />
            <TextBlock Text="Keyboard Control &amp; Diagnostics" Margin="0,8" />
            <TextBlock Text="Offline by design. No drivers, global keyboard hooks, game injection, or latency improvement claims. Input timing measures delivery to this application, not physical-to-display latency." Opacity="0.7" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</ui:FluentWindow>
